# Атомарный арбитраж через контракт FlashArb (Aave flash loan)
# После деплоя на Base:
# FLASH_ARB_CONTRACT=0xYourDeployedFlashArb

# Переопределение размера займа в wei (WETH). Пусто = брать NOTIONAL из сигнала (wethIn)
# FLASH_LOAN_AMOUNT_WEI=2000000000000000000

# Минимальный чистый профит в wei WETH после возврата займа + премии Aave
# FLASH_MIN_PROFIT_WEI=1000000000000000

# Макс. допустимый «налог» на transfer после buy: minToken >= expected * (1 - pct/100), плюс REAL_MAX_SLIPPAGE_PCT
# FLASH_MAX_TAX_PCT=5

# TTL кэша «плохих» токенов после неуспешной on-chain tx (часы)
# FLASH_BAD_TOKEN_TTL_HOURS=24
