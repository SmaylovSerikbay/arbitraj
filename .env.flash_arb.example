# =============================================================================
# СКОПИРУЙ НУЖНЫЕ СТРОКИ В СВОЙ .env (VDS или локально). Секреты не коммить.
# =============================================================================

# --- RPC Base (HTTPS). Нужен боту и команде forge create ---
# Если строка RPC_URL_DRPC у тебя УЖЕ есть в .env — второй раз не добавляй.
RPC_URL_DRPC=https://lb.drpc.live/base/ВСТАВЬ_СВОЙ_RPC_КЛЮЧ

# Альтернативное имя (если бот читает только BASE_HTTP — продублируй тот же URL сюда):
# BASE_HTTP=https://...

# --- Деплой FlashArb (forge не читает .env сам: сначала source .env) ---
# Приватный ключ кошелька, с которого деплоишь. Owner контракта = этот адрес.
# Для вызова executeArb с бота owner должен совпадать с TRADER_PRIVATE_KEY (или сделай transferOwnership).
DEPLOYER_PRIVATE_KEY=0xВСТАВЬ_64_СИМВОЛА_HEX

# После успешного forge create вставь адрес:
FLASH_ARB_CONTRACT=

# --- Параметры flash-арба в боте (опционально) ---
# Размер займа WETH в wei; пусто = как в сигнале (notional)
# FLASH_LOAN_AMOUNT_WEI=2000000000000000000

# Мин. прибыль в wei WETH после возврата займа + премии Aave
FLASH_MIN_PROFIT_WEI=1000000000000000

# Макс. «налог» на transfer после buy (%), вместе с REAL_MAX_SLIPPAGE_PCT
FLASH_MAX_TAX_PCT=5

# TTL кэша плохих токенов (часы) после failed on-chain tx
FLASH_BAD_TOKEN_TTL_HOURS=24

# =============================================================================
# ОДНА КОМАНДА ДЕПЛОЯ (Ubuntu, из репозитория arbitraj):
#
#   cd ~/arbitraj && set -a && source .env && set +a && cd contracts && \
#   forge create src/FlashArb.sol:FlashArb \
#     --rpc-url "$RPC_URL_DRPC" \
#     --private-key "$DEPLOYER_PRIVATE_KEY" \
#     --constructor-args 0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
#
# Проверка, что RPC виден из shell:
#   set -a && source .env && set +a && echo "len=${#RPC_URL_DRPC}"
# =============================================================================
